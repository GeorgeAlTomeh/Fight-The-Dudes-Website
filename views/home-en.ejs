<!DOCTYPE html>
<html lang="en">
  <head>
    <meta http-equiv="content-type" content="text/html; charset=utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Fight The Dudes</title>
    <link rel="stylesheet" href="style.css" type="text/css" media="all" />
    <style type="text/css" media="all">
      *{
        margin: 0;
        padding: 0;
        font-family: System-UI, Tahoma, Arial;
      }
      body{
        background-color: #001220;
        overflow-x: hidden;
      }
      a{
        color: #ffeeef;
        text-decoration: none;
      }
      a:hover {
        opacity: 0.8;
      }
      div.head{
        display: flex;
        justify-content: space-between;
        border-bottom: #223442 1px solid;
        padding: 10px;
        height: 7%;
        width: 100vw;
        position: fixed;
        background-color: #001220;
        z-index: 1000;
      }
      a.logo img{
        border-radius: 50%;
      }
      div.head div.left, div.head div.right {
        text-align: center;
        color: #ffeeef;
        font-size: 6vw;
      }
      .left{
        width: 35%;
      }
      .right{
        width: 65%;
      }
      div.left, div.right{
        display: flex;
        justify-content: space-between;
      }
      .l,.r{
        width: 50%;
        margin-top: 2vh;
      }
      .l svg, .r svg{
        width: 50%;
      }
      .logo, .name{
        text-align: center;
      }
      .logo{
        width: 35%;
      }
      .name{
        width: 65%;
      }
      div.body{
        padding-top: 10%;
      }
      div.container{
        width: 100vw;
        overflow-x: hidden;
      }
      div.gradienrBetweenBodyAndFooter{
        position: relative;
        top: 3vh;
      }
      #visual{
        width: 100vw;
        transform: scale(1.4);
      }
      .body{
        width: 80%;
        margin: auto;
      }
      .body img{
        width: 100%;
        margin-top: 27%;
      }
      .title{
        text-align: center;
        color: #e61e1e;
        font-size: 1.5rem;
      }
      .l3y{
        text-align: center;
        color: #f35447;
        line-height: 1.6;
        font-size: 1.1rem;
      }
      .btn{
        display: block;
        color: #ffeeef;
        border: none;
        background-color: #f35447;
        width: 60%;
        padding: max(10px,2.25vh);
        margin: auto;
        outline: none;
        border-radius: 10px;
        text-align: center;
        text-decoration: none;
        cursor: pointer;
        font-size: 1.1rem;
      }
      div.footer{
        background-color: #e61e1e;
        width: 100vw;
        overflow-x: hidden;
        overflow-y: hidden;
        padding: 20px 0;
      }
      .lft {
        text-align: center;
        color: white;
        margin: 20px 0;
      }
      .lft ul {
        list-style: none;
      }
      .lft ul li {
        margin: 10px 0;
        display: inline-block;
        margin-right: 15px;
      }
      .lft ul li.choosed {
        font-weight: bold;
        text-decoration: underline;
      }
      .lft h4 {
        margin-bottom: 15px;
        font-size: 1.2rem;
      }
    </style>
  </head>
